          <a class="contact-link" href="https://www.linkedin.com/in/matthew-cannella-mba-ms-lat-atc-85483646" target="_blank">LinkedIn - Matthew Cannella</a>
        </div>
        <div class="dis-box"><strong>2025 Advanced Athletic Medicine. All rights reserved.</strong><br><br>This manual is provided for educational and training purposes only. It does not constitute medical advice and is not a substitute for individualized evaluation or treatment by a qualified healthcare professional.</div>
      </div>

    </div>
  </div>
</div>

<script>
var CODE = 'AAM2025';
function checkCode() {
  var v = document.getElementById('codeInput').value.trim().toUpperCase();
  if (v === CODE) {
    document.getElementById('gate').style.display = 'none';
    document.getElementById('app').style.display = 'block';
  } else {
    document.getElementById('gateErr').textContent = 'Incorrect code.';
  }
}
document.getElementById('codeInput').onkeydown = function(e) { if (e.key === 'Enter') checkCode(); };

var titles = {home:'Home',why:'Why Arm Care Matters',standards:'AAM Standards',redflags:'Red Flags',tspine:'T-Spine Mobility',foamroll:'Foam Roll',stretching:'Static Stretching',dynamic:'Dynamic Warm-Up',prebands:'Pre-Throw Bands',postbands:'Post-Throw Bands',scapular:'Scapular Control',twoout:'2-Out Drill',gethot:'Get Hot Routine',gameday:'Game Day Routines',rtt:'Return-to-Throw',mound:'Mound Progression',pitchcount:'Pitch Count Rules',recovery:'Recovery',youth:'Youth Arm Care',annual:'Annual Planning',readiness:'Arm Readiness Check',tracker:'Volume Tracker',scheduler:'Weekly Builder',faq:'FAQ',contact:'Contact'};

function showSection(id) {
  document.querySelectorAll('.section').forEach(function(s) { s.classList.remove('active'); });
  document.querySelectorAll('.nav-item').forEach(function(n) { n.classList.remove('active'); });
  var sec = document.getElementById('sec-' + id);
  if (sec) sec.classList.add('active');
  document.getElementById('pageTitle').textContent = titles[id] || id;
  document.querySelectorAll('.nav-item').forEach(function(n) {
    if (n.getAttribute('onclick') && n.getAttribute('onclick').indexOf("'" + id + "'") >= 0) n.classList.add('active');
  });
  document.getElementById('contentArea').style.padding = id === 'home' ? '0' : '32px 36px';
  window.scrollTo(0, 0);
  document.getElementById('sidebar').classList.remove('open');
}
function toggleMenu() { document.getElementById('sidebar').classList.toggle('open'); }

function showRoutine(id, el) {
  document.querySelectorAll('.rcontent').forEach(function(r) { r.classList.remove('active'); });
  document.querySelectorAll('.rtab').forEach(function(t) { t.classList.remove('active'); });
  document.getElementById('routine-' + id).classList.add('active');
  el.classList.add('active');
}

var rttData = [
  {n:1,rows:[["45ft","20"],["REST","5 min"],["45ft","20"]]},
  {n:2,rows:[["45ft","20"],["REST","5 min"],["45ft","20"],["REST","5 min"],["45ft","20"]]},
  {n:3,rows:[["45ft","20"],["REST","5 min"],["45ft","20"],["REST","5 min"],["45ft","20"]]},
  {n:4,rows:[["45ft","15"],["60ft","20"],["REST","5 min"],["45ft","15"],["60ft","20"]]},
  {n:5,rows:[["45ft","15"],["60ft","20"],["REST","5 min"],["45ft","15"],["60ft","20"],["75ft","5-10"]]},
  {n:6,rows:[["45ft","5-10"],["60ft","10"],["REST","3-5 min"],["75ft","20"],["REST","5 min"],["75ft","5-10"]]},
  {n:7,rows:[["45ft","5-10"],["60ft","10"],["REST","3-5 min"],["75ft","20"],["REST","5 min"],["75ft","10"]]},
  {n:8,rows:[["45ft","5-10"],["60ft","10"],["90ft","15"],["REST","5 min"],["45ft","5-10"],["60ft","10"],["90ft","15"]]},
  {n:9,rows:[["45ft","5-10"],["60ft","10"],["90ft","15"],["REST","5 min"],["45ft","5-10"],["60ft","10"],["90ft","15"],["REST","5 min"],["45ft","5-10"],["60ft","10"],["90ft","15"]]},
  {n:10,rows:[["45ft","5"],["60ft","10"],["90ft","10"],["120ft","15"],["REST","5 min"],["45ft","5"],["60ft","10"],["90ft","10"],["120ft","15"]]},
  {n:11,rows:[["45ft","5"],["60ft","10"],["90ft","10"],["120ft","15"],["REST","5 min"],["45ft","5"],["60ft","10"],["90ft","10"],["120ft","15"]]}
];
var sc = document.getElementById('rtt-steps');
if (sc) {
  rttData.forEach(function(s) {
    var rows = s.rows.map(function(r) {
      return '<div class="step-row' + (r[0]==='REST'?' rest':'') + '"><span class="dist">' + (r[0]==='REST'?'Rest':r[0]) + '</span><span>' + r[1] + '</span></div>';
    }).join('');
    sc.innerHTML += '<div class="step-card"><div class="step-hdr">STEP ' + s.n + '</div>' + rows + '</div>';
  });
}

var faqs = [
  {q:"Why can not my athlete throw every day?",a:"Throwing places repetitive stress on the shoulder and elbow. After a throwing session, the tissues - tendons, ligaments, muscles, and cartilage - undergo microtrauma that requires time to repair. Rest days are not wasted days - they are when adaptation actually happens."},
  {q:"My athlete says the arm feels fine - why limit pitch count?",a:"Feeling fine is not the same as being recovered. Many arm injuries - including UCL tears and stress reactions - develop gradually over weeks or months before any pain appears. Pitch count limits exist because athletes who exceed them have dramatically higher injury rates, regardless of how they feel."},
  {q:"When is my athlete ready to pitch again after taking time off?",a:"Return to pitching after a layoff requires a structured build-up - not just a few days of catch. For a standard offseason shutdown, athletes typically need 6-8 weeks of progressive throwing before pitching competitively. Following an injury, the timeline requires medical clearance."},
  {q:"What does normal arm soreness look like after pitching?",a:"Mild muscle soreness that peaks at 24 hours and resolves by 36-48 hours is generally normal. What is NOT normal: sharp or stabbing pain during throwing, soreness that worsens after each outing, joint pain rather than muscle soreness, or numbness or tingling in the arm or hand."},
  {q:"Is year-round baseball a problem?",a:"Yes - when it eliminates the opportunity for structured rest and recovery. Athletes who throw for 10 or more months per year without a meaningful break have significantly higher rates of elbow and shoulder injury. A structured shutdown of 4-8 weeks followed by a proper build-up dramatically reduces cumulative stress."},
  {q:"Should my athlete play other sports?",a:"Yes - especially in adolescence. Multi-sport participation through high school has been associated with lower overuse injury rates and longer athletic careers. Sport specialization before age 14 is consistently linked to higher injury risk and earlier burnout."},
  {q:"Are weighted balls safe for my athlete?",a:"Weighted ball training carries meaningful injury risk, particularly for younger athletes and those with any history of arm injury. AAM position: weighted balls may be appropriate for athletes 16 and older who are pain-free, have adequate arm strength and mobility, and are supervised by a qualified professional. Not appropriate for athletes under 16."},
  {q:"What is the difference between arm soreness and arm pain?",a:"Soreness is a diffuse muscular ache that develops 12-24 hours after activity and is not present during throwing. Pain is present during activity, is often focal in a specific spot, and may be sharp, stabbing, or burning. If it hurts during throwing - stop and seek evaluation."},
  {q:"Should my athlete ice after every outing?",a:"Icing after throwing is effective for managing soreness. However, do not apply for more than 15 minutes and do not use directly before throwing as it can reduce proprioception. Post-throw stretching and band work are at least as important as icing for long-term arm health."},
  {q:"What should I do if my athlete complains of elbow or shoulder pain?",a:"Stop throwing immediately. Schedule an evaluation with a sports medicine physician or orthopedic specialist - not after the season, now. Early evaluation of throwing-related pain dramatically improves outcomes."},
  {q:"How do I know if my athlete needs to see a doctor vs just rest?",a:"See a doctor if any of the following are present: pain during or immediately after throwing, numbness or tingling in the arm or hand, visible swelling, loss of range of motion, pain persisting more than 2 weeks, or a sudden significant drop in velocity. When in doubt, err on the side of evaluation."},
  {q:"What is GIRD and Total Arc and why does it matter?",a:"GIRD - Glenohumeral Internal Rotation Deficit - refers to loss of internal rotation in the throwing shoulder compared to the non-throwing side. A loss exceeding 20 degrees is clinically significant. However, total arc is equally important: if internal rotation decreases but external rotation increases by a similar amount, total arc may be preserved. At AAM, we assess both GIRD and total arc together."}
];
var fc = document.getElementById('faq-container');
if (fc) {
  faqs.forEach(function(f, i) {
    var item = document.createElement('div');
    item.className = 'faq-item';
    var q = document.createElement('div');
    q.className = 'faq-q';
    q.innerHTML = '<span>Q' + (i+1) + ': ' + f.q + '</span><span class="faq-tog">+</span>';
    q.onclick = function() {
      this.classList.toggle('open');
      this.nextSibling.classList.toggle('open');
      this.querySelector('.faq-tog').textContent = this.classList.contains('open') ? 'x' : '+';
    };
    var a = document.createElement('div');
    a.className = 'faq-a';
    a.textContent = f.a;
    item.appendChild(q);
    item.appendChild(a);
    fc.appendChild(item);
  });
}
</script>
</body>
</html>
